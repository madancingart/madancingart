NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true: „Zapisz się i zapłać” oraz przycisk Zapłać otwierają Stripe. false: zapis zostaje, płatność na sali.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# true pokazuje „Zaloguj się” / „Moje konto” i otwiera /konto. false ukrywa linki, a /konto zwraca 404.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
# Opcjonalnie: Cloudflare Turnstile (Supabase → Authentication → Attack Protection). Sekret zostaje w Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Lokalnie webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Panel: login „admin” (konto admin@madancingart.pl)
CRON_SECRET=
# off: bot nic nie robi. dry-run: liczy i wysyła jeden mail „[TEST] Co bot zrobiłby dziś”. live: wystawia należności i pisze do klientów.
BILLING_MODE=off
# Odbiorca maila testowego w trybie dry-run.
ADMIN_DIGEST_EMAIL=
AUTO_RELEASE_UNCONFIRMED=false
# Opcjonalnie stały token feedu iCal (iPhone). Bez tego token liczy się z klucza serwera.
CALENDAR_ICS_TOKEN=
